<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="profisc_custom_changes_casa.ReceiptHeaderChange"
       t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="after">
            <div class="pos-receipt-table-no" t-if="props.data.table_no">
                <strong>Table NO: </strong>
                <t t-esc="props.data.table_no"/>
            </div>
        </xpath>
    </t>

</templates>
