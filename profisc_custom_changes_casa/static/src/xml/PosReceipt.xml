<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Extend OrderReceipt: add fiscal fields after footer -->
    <t t-name="pos_receipt_header_inherit"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">

        <xpath expr="//div[@class='pos-receipt-amount']" position="attributes">
            <attribute name="style">font-size: 26px !important; font-weight: bold;</attribute>
        </xpath>

    </t>


</templates>
