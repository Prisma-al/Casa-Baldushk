    <t t-name="pos_receipt_header_inherit"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">

        <xpath expr="//div[hasclass('receipt-total')]" position="attributes">
            <attribute name="style">font-size: 26px !important; font-weight: bold;</attribute>
        </xpath>

    </t>


</templates>
