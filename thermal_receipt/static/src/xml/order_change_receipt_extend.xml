<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="thermal_receipt.OrderChangeReceipt" t-inherit="point_of_sale.OrderChangeReceipt" t-inherit-mode="extension">

        <!-- Replace the standard order reference line with a large header
             carrying the order number, the table and the tracking number. -->
        <xpath expr="//span[hasclass('my-4')]" position="replace">
            <div><strong>Dine in</strong></div>
            <div class="order-number mb-2">
                <strong>Order Number: <t t-esc="data.pos_reference"/></strong>
            </div>
            <div class="category-header fw-bold text-uppercase border-bottom pb-2"
                 style="font-size: 36px; font-weight: 800;">
                <t t-if="data.table_name">
                    Table <strong><t t-esc="data.table_name"/></strong>
                </t>
                <t t-if="data.tracking_number">
                    # <strong><t t-esc="data.tracking_number"/></strong>
                </t>
            </div>
        </xpath>

        <!-- Enlarge the category headers produced by the grouped rendering. -->
        <xpath expr="//div[@t-esc='group.name']" position="attributes">
            <attribute name="class">text-uppercase pb-2 mb-3</attribute>
            <attribute name="style">font-size: 42px; font-weight: 900; letter-spacing: 2px; border-bottom: 2px solid black;</attribute>
        </xpath>

    </t>

    <t t-name="thermal_receipt.OrderChangeReceiptLine" t-inherit="point_of_sale.OrderChangeReceiptLine" t-inherit-mode="extension">

        <!-- Enlarge the product lines. Notes and attribute values keep their
             relative sizing and stay readable. -->
        <xpath expr="//div[starts-with(@t-attf-class, 'orderline')]" position="attributes">
            <attribute name="style">font-size: 32px; font-weight: 600;</attribute>
        </xpath>

    </t>

</templates>
