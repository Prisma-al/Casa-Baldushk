<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_pos_category_form_view_skip_preparation" model="ir.ui.view">
        <field name="name">pos.category.form.skip.preparation</field>
        <field name="model">pos.category</field>
        <field name="inherit_id" ref="point_of_sale.product_pos_category_form_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="skip_preparation"/>
            </field>
        </field>
    </record>

    <record id="product_pos_category_tree_view_skip_preparation" model="ir.ui.view">
        <field name="name">pos.category.list.skip.preparation</field>
        <field name="model">pos.category</field>
        <field name="inherit_id" ref="point_of_sale.product_pos_category_tree_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="skip_preparation" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
